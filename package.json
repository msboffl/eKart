{
  "name": "@ekart/source",
  "version": "0.0.1",
  "description": "eKart is an microservice ecommerce application",
  "main": "index.js",
  "scripts": {
    "generate:tree": "struct -i .next -i target -o project.tree",
    "auth:dev": "cd micros/auth-service && (./mvnw spring-boot:run || mvnw.cmd spring-boot:run)",
    "auth:build": "cd micros/auth-service && (./mvnw clean package -DskipTests || mvnw.cmd clean package -DskipTests)",
    "auth:start": "java -jar micros/auth-service/target/auth-service-0.0.1-SNAPSHOT.jar"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msboffl/eKart.git"
  },
  "keywords": [
    "ekart"
  ],
  "author": "Mareedu Saibabu",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/msboffl/eKart/issues"
  },
  "homepage": "https://github.com/msboffl/eKart#readme",
  "devDependencies": {
    "@structure-codes/cli": "^0.0.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "typescript": "^5.9.2"
  }
}